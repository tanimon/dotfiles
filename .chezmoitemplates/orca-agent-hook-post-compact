{{- /*
orca agent-hooks integration の PostCompact 用 hook エントリ。

orca は PostCompact にだけ、他の event(orca-agent-hook)とは別の snippet を書く。
$HOME が未設定か dispatcher が無いときは stdin を読み捨てるだけで、printf '{}' を出さない。
この形を書くのは Unix の orca だけで、Windows の orca は PostCompact にも orca-agent-hook と
同じ形を書く。この partial は OS で分岐しないので、Windows では orca が書く形と一致しない。
toJson の escape と live からの再同期手順は orca-agent-hook の冒頭と同じで、取り出す jq は次の 1 行:

  jq -r '.hooks.PostCompact[].hooks[] | select((.command // "") | test("orca/agent-hooks")) | .command' ~/.claude/settings.json
*/ -}}
{{- $command := `if [ -n "${HOME-}" ] && [ -f "${HOME-}/.orca/agent-hooks/claude-hook.sh" ] && [ -r "${HOME-}/.orca/agent-hooks/claude-hook.sh" ] && [ -x "${HOME-}/.orca/agent-hooks/claude-hook.sh" ]; then ORCA_HOOK_AGENT_PID="${PPID:-}"; export ORCA_HOOK_AGENT_PID; /bin/sh "${HOME-}/.orca/agent-hooks/claude-hook.sh"; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi` -}}
{"type": "command", "command": {{ $command | toJson | replace "\\u0026" "&" | replace "\\u003c" "<" | replace "\\u003e" ">" }}, "timeout": 10}
