# ref: https://blog.gitbutler.com/how-git-core-devs-configure-git
[alias]
  co = checkout
  sw = !git branch -a --format='%(refname:short)' | sed 's/^origin\\///' | grep -v '^HEAD' | sort -u | fzf | xargs -I{} git switch {}
[branch]
  sort = -committerdate
[column]
  ui = auto
[commit]
  verbose = true
  gpgsign = true
[core]
  autocrlf = input
  excludesfile = ~/.gitignore
  fsmonitor = true
  untrackedCache = true
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  tool = difft
  external = difft
[fetch]
  prune = true
  pruneTags = true
  all = true
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[merge]
  conflictstyle = zdiff3
[pull]
  rebase = false
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoupdate = true
[tag]
  sort = version:refname
[user]
  name = tanimon
  email = 8575113+tanimon@users.noreply.github.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPqE5lfvsdUH7CAsIodo8L4zv3MY5s02cfR8sGjqYcBW

# ref: https://1password.com/blog/git-commit-signing
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# git-wt
[wt]
  basedir = ".claude/worktrees"
  copy = "docs/"

# 個人リポジトリでは excludesfile を差し替え、superpowers/ce 系スキル生成の経緯ドキュメント
# (docs/plans/・docs/superpowers/ 等 — 一覧は ~/.gitignore 側)を commit できるようにする。
# デフォルト(未登録の場所 = 仕事リポジトリや OSS クローン)は除外側に倒すフェイルセーフ。
# gitdir は worktree でも本体リポジトリの .git 配下を指すため、worktree にも自動で効く。
# 注意: この includeIf は上の [core] excludesfile より後に置くこと。git は include を
# 記述位置で展開し単一値キーは後勝ちのため、順序が逆になると差し替えが無言で効かなくなる。
[includeIf "gitdir:~/ghq/github.com/tanimon/"]
  path = ~/.config/git/personal.inc
[includeIf "gitdir:~/.local/share/chezmoi/"]
  path = ~/.config/git/personal.inc

{{ if eq .profile "work" -}}
### 会社用設定
{{/* 2026-07-31: https→ssh の insteadOf を廃止し、逆方向(ssh→https)に反転した。狙いは Claude Code のネイティブサンドボックス（settings.json.tmpl の sandbox.network）内で git を使えるようにすること。ネイティブサンドボックスは HTTP(S) プロキシ経由の egress のみを許可し、github.com:22 への生 TCP を拒否するため、リモートが git@github.com: 形式のままだと fetch/pull/push が軒並み失敗する（実測: `ssh: Could not resolve hostname github.com`）。逆方向の insteadOf を追加するだけでは不十分で、この https→ssh ルールと共存させると（両方が gitconfig に存在する状態で）git の内部解決が SSH 側を優先してしまい、逆方向ルールが効かないことを実測で確認した（GIT_TRACE=1 で `ssh ... git@github.com` のまま）。GIT_CONFIG_GLOBAL=/dev/null で本ファイルを丸ごと無視した場合のみ逆方向ルールが機能した。`-c`/`GIT_CONFIG_KEY_n` はURLを含むキーのパースに失敗している可能性を疑い、`include.path` でファイルベースの逆方向ルールのみを追加して再検証したが、https→ssh ルールと共存させたままでは同じく機能しなかった（`-c` 構文の問題ではなく、この2ルールの共存自体が原因）。内部メカニズムの詳細（gitのinsteadOf解決アルゴリズムのどこで優先されるか）は未特定。認証は既存の credential.helper（GCM、下記）が担う。commit 署名は gpg.format=ssh 経由で 1Password SSH agent を使い続けるため、この変更の影響を受けない。 */ -}}
[url "https://github.com/"]
  insteadOf = git@github.com:
[gtr "copy"]
  include = **/.envrc
  include = tmp/scripts/**
  include = .claude/settings.local.json
[gtr "editor"]
  default = code
[credential]
  helper =
  helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
  useHttpPath = true
{{ end -}}
