# ref: https://blog.gitbutler.com/how-git-core-devs-configure-git
[alias]
  co = checkout
  sw = !git branch -a --format='%(refname:short)' | sed 's/^origin\\///' | grep -v '^HEAD' | sort -u | fzf | xargs -I{} git switch {}
[branch]
  sort = -committerdate
[column]
  ui = auto
[commit]
  verbose = true
  gpgsign = true
[core]
  autocrlf = input
  excludesfile = ~/.gitignore
  fsmonitor = true
  untrackedCache = true
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
  tool = difft
  external = difft
[fetch]
  prune = true
  pruneTags = true
  all = true
[help]
  autocorrect = prompt
[init]
  defaultBranch = main
[merge]
  conflictstyle = zdiff3
[pull]
  rebase = false
# push.autoSetupRemote は書かない(理由は ~/.config/git/claude-code.inc の「背景4」)。
# 代わりに default = current で upstream 無しの素の `git push` を同名のリモートブランチへ送り、
# status.compareBranches の @{push} で upstream 無しでも長形式の `git status` に ahead/behind を出す。
# upstream があるブランチは @{upstream} とも比べる(同じ ref なら 1 回だけ出る)。
# status.compareBranches は git 2.54 以降。古い git(/usr/bin/git など)は黙って無視し、ahead/behind が出ない。
# 受容するトレードオフ:
# - upstream の無いブランチでは `git pull`、`@{u}`、`git rebase` の既定 upstream が無いものとして
#   振る舞い、`git status -sb` の短形式と starship の ahead_behind には ahead/behind が出ない。
#   対話ターミナルで upstream が欲しいブランチは、初回に `git push -u` を打つ。
# - upstream の名前がローカル名と違うブランチでも、素の `git push` はエラーで止まらず
#   ローカル名のリモートブランチへ送る(simple なら止まっていた)。
[push]
  default = current
  followTags = true
[status]
  compareBranches = @{upstream} @{push}
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[rerere]
  enabled = true
  autoupdate = true
[tag]
  sort = version:refname
[user]
  name = tanimon
  email = 8575113+tanimon@users.noreply.github.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPqE5lfvsdUH7CAsIodo8L4zv3MY5s02cfR8sGjqYcBW

# ref: https://1password.com/blog/git-commit-signing
[gpg]
  format = ssh
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# git-wt
[wt]
  basedir = ".claude/worktrees"
  copy = "docs/"

# 個人リポジトリでは excludesfile を差し替え、superpowers/ce 系スキル生成の経緯ドキュメント
# (docs/plans/・docs/superpowers/ 等 — 一覧は ~/.gitignore 側)を commit できるようにする。
# デフォルト(未登録の場所 = 仕事リポジトリや OSS クローン)は除外側に倒すフェイルセーフ。
# gitdir は worktree でも本体リポジトリの .git 配下を指すため、worktree にも自動で効く。
# 注意: この includeIf は上の [core] excludesfile より後に置くこと。git は include を
# 記述位置で展開し単一値キーは後勝ちのため、順序が逆になると差し替えが無言で効かなくなる。
[includeIf "gitdir:~/ghq/github.com/tanimon/"]
  path = ~/.config/git/personal.inc
[includeIf "gitdir:~/.local/share/chezmoi/"]
  path = ~/.config/git/personal.inc

{{ if eq .profile "work" -}}
### 会社用設定
{{/* ssh→https の insteadOf。Claude Code のネイティブサンドボックスは HTTP(S) プロキシ経由の egress だけを許可し github.com:22 への生 TCP を拒否するので、SSH 形式の remote を HTTPS に寄せる(実測: scp 形式のままだと `ssh: Could not resolve hostname github.com`、ssh:// 形式はサンドボックスが注入する SOCKS5 の nc が拒否されて `Broken pipe`)。scp 形式(git@github.com:)と ssh://git@github.com/ 形式の両方を書く。https→ssh の逆向きルールと共存させると、こちらが効かなくなる(GIT_TRACE=1 で実測。git 内部の仕組みは未特定。共存させないこと)。認証は下の credential.helper(GCM)。 */ -}}
[url "https://github.com/"]
  insteadOf = git@github.com:
  insteadOf = ssh://git@github.com/
[gtr "copy"]
  include = **/.envrc
  include = tmp/scripts/**
  include = .claude/settings.local.json
[gtr "editor"]
  default = code
[credential]
  helper =
  helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://dev.azure.com"]
  useHttpPath = true
{{ end -}}
