# Modular config (~/.config/zsh/)
source ~/.config/zsh/path.zsh
source ~/.config/zsh/sandbox.zsh
source ~/.config/zsh/aws.zsh


# Environment variables
[[ -f $HOME/.env ]] && source ${HOME}/.env
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
export EDITOR="hx"


# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt inc_append_history
setopt hist_ignore_all_dups
setopt hist_no_store
setopt hist_reduce_blanks
setopt share_history


# Completion
# sentry
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)
autoload -Uz compinit
compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' '+m:{A-Z}={a-z}'
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
zstyle ':completion:*' menu select
zstyle ':completion:*:git:*' group-order 'main commands' 'alias commands' 'external commands'

command -v aqua &>/dev/null && source <(aqua completion zsh)
command -v brew &>/dev/null && fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
command -v chezmoi &>/dev/null && source <(chezmoi completion zsh)
command -v dyff &>/dev/null && source <(dyff completion zsh)
command -v kubectl &>/dev/null && source <(kubectl completion zsh)

fpath+=~/.zfunc


ZSH_AUTOSUGGEST_STRATEGY=(history completion)


# Disable beep when listing candidates for completion
setopt nolistbeep


# Claude Code の Bash ツールでだけ `=cmd` 展開を切る。理由は ~/.claude/rules/claude-code/bash-tool.md の
# `=cmd` 展開の項。Bash ツールは起動時のシェルスナップショットに setopt の状態を写して使うので、
# ここで立てた option がスナップショット経由で効く。人の対話シェルでは `=cmd` 展開を残す
[[ -n "${CLAUDECODE:-}" ]] && setopt no_equals


# Enable zmv
autoload -Uz zmv
alias zmv='noglob zmv -W'


# Aliases
# Claude Code の Bash ツールは、セッション開始時にこのファイルを読んだシェルの alias を再生する。eza と difft は
# ls / diff と引数も終了コードも違い(eza の -t は値を取り、difft は差分があっても 0 で終わる)、`ls -t` や
# `diff a b && echo same` が黙って誤るので、Claude Code の内側(CLAUDECODE が立つ)では置き換えない。
if [[ -z "${CLAUDECODE:-}" ]]; then
    alias ls='eza'
    alias ll='eza -l'
    alias la='eza -la'

    alias diff='difft --display side-by-side-show-both'
fi


# Tool initializations
command -v carapace &>/dev/null && source <(carapace _carapace)
command -v fzf &>/dev/null && source <(fzf --zsh)
# gtr shell integration: provides `gtr cd`, `gtr new --cd`, and completions
_gtr_init="${XDG_CACHE_HOME:-$HOME/.cache}/gtr/init-gtr.zsh"
[[ -f "$_gtr_init" ]] || eval "$(git gtr init zsh)" 2>/dev/null || true
source "$_gtr_init" 2>/dev/null || true; unset _gtr_init
command -v git-wt &>/dev/null && eval "$(git wt --init zsh)"
command -v mise &>/dev/null && eval "$(mise activate zsh)"
command -v sheldon &>/dev/null && eval "$(sheldon source)"
command -v starship &>/dev/null && eval "$(starship init zsh)"
command -v zoxide &>/dev/null && eval "$(zoxide init zsh --cmd cd)"
