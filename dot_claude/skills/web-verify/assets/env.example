# 検証対象アプリのベースURL(例: http://127.0.0.1:8080)。
# worktree ごとにポートが違う場合は、実行時に VERIFY_BASE_URL=... を渡すとこの値より優先される
VERIFY_BASE_URL=
# ログイン資格情報(値はこのファイルではなく .env に書く)
VERIFY_LOGIN_ID=
VERIFY_LOGIN_PASSWORD=
# VERIFY_REPO_DIR(検証対象の worktree)と VERIFY_FEATURE(機能の slug)は実行ごとに変わるので、
# ここには書かず実行時に渡す(README.md の「実行方法」)
