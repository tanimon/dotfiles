      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(fd:*)",
      {{/* gh api の PR レビュー投稿エンドポイントのみ allow。Bash ルールの `*` は「スペースを含む任意のテキスト」にマッチし `/` も跨ぐため、owner と repo をワイルドカード 2 つに分けても 1 つにまとめても動くが、絞れる分だけ 2 つに分ける形を採る。末尾 `:*` は「スペース + 任意」の意味なので、パス末尾に `/` が続く形 — レビュー削除 `.../reviews/<id> -X DELETE` や dismiss `.../reviews/<id>/dismissals -X PUT` — はマッチせず ask/クラシファイア判定に落ちる。つまりこの 2 行が無確認で通すのは「コレクションエンドポイントへの投稿」だけで、既存レビューの破壊的操作は含まれない。ただしこれはパスを先に書いた場合のみで、`gh api -X POST repos/...` のようにメソッドをパスより前に置く語順ではマッチせず毎回プロンプトが出る。 */ -}}
      "Bash(gh api repos/*/*/pulls/*/comments:*)",
      "Bash(gh api repos/*/*/pulls/*/reviews:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo list:*)",
      "Bash(git -c core.fsmonitor=false diff:*)",
      "Bash(git -c core.fsmonitor=false log:*)",
      "Bash(git -c core.fsmonitor=false rev-parse:*)",
      "Bash(git -c core.fsmonitor=false show:*)",
      "Bash(git -c core.fsmonitor=false status:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git revert:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git submodule:*)",
      "Bash(git worktree:*)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go env:*)",
