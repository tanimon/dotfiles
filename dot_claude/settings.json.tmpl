        "source": "github",
        "repo": "EveryInc/compound-engineering-plugin"
      },
      "autoUpdate": true
    },
    "cclens": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/cclens"
      }
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "humanlayer/skills"
      }
    }
  },
  "model": "opus[1m]",
  {{/* modelSettings: モデル別の設定。/model ダイアログが書き込んだ値をそのまま反映している。現状はどちらもトップレベルの "effortLevel"(ファイル末尾)と同じ high なので実質冗長だが、live の ~/.claude/settings.json と一致させるために保持する。 */ -}}
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  {{/* advisorModel: サーバーサイド advisor tool の助言役モデル（指定可能なエイリアスは fable / opus / sonnet）。advisor は executor（メインモデル）と同等以上の能力でないと attach されない（公式ドキュメント https://code.claude.com/docs/en/advisor の「at least as capable as the main model」。同一モデル同士も可）ため、上の "model" と対になって初めて機能する。現在の組み合わせは executor=opus[1m] / advisor=opus で、Opus 5.5 main は Opus 5 以降の advisor を受け付けるので main セッションでも発動する。/model で fable に切り替えたセッションでは Opus advisor は rejected となり main では発動せず（サブエージェントでは発動しうる）、起動時通知でその旨が出る。"model" の [1m] はメインモデルの 1M コンテキスト指定で、advisorModel はエイリアスかフル ID しか受け付けない（[1m] の記載なし。未認識のモデルだと advisor は attach されない）ため、両者を同じ表記に揃えないこと。会話が advisor 側のコンテキスト窓を超えると advisor 呼び出しだけが prompt_too_long で失敗する（セッションは継続）。トークン消費は増える。/advisor ダイアログが書き込む先は ~/.claude/settings.json だが、そのファイルはこの tmpl が全面所有しているため apply で消える。恒久設定はここに書くこと。 */ -}}
  "advisorModel": "opus",
  {{/* orca agent-hooks integration: orca が dispatcher を差し込む全 event のエントリは .chezmoitemplates/orca-agent-hook から参照する。仕組みと live からの再同期手順はそのファイルの冒頭にある。 */ -}}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/harness-briefing.sh\" 2>>\"$HOME/.claude/logs/harness-errors.log\" || true'"
          },
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/worktree-include.sh\" 2>>\"$HOME/.claude/logs/worktree-include-errors.log\" || true'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/notify.sh\" 2>>\"$HOME/.claude/logs/notify-errors.log\" || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/secretlint-guard.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/harness-reflect-trigger.sh\" 2>>\"$HOME/.claude/logs/harness-errors.log\" || true'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "PreToolUse": [
      {{/* git push の破壊的な綴りだけをゲートするフック。`Bash(git push:*)` を permissions.ask に置いていた頃は日常の push まで毎回プロンプトになっていたが、ask を外すだけでは `git push origin main --force` / `+main` / `--delete` / `--mirror` が無ゲートになる — deny はプレフィックス照合なので、フラグが `git push` の直後に来る綴りしか捕まえられないため(2026-07-25 の tier model spec が push を Tier 1 から撤回した理由そのもの)。フックはコマンド文字列全体を受け取るので、引数位置に依存しない判定が書ける。素の push は無出力 exit 0 で defaultMode: auto のクラシファイア判定に落ち、プロンプトは出ない。複数の PreToolUse が一致した場合の合成は deny > ask > allow なので、下の orca フック(matcher "*")と併存して問題ない。残存: スクリプトが未配置・クラッシュした場合は無出力=判定なしとなりフェイルオープンする(deny 側に残した先頭フラグ形の 3 行が最後の砦)。Source 上の未配線は test/settings-hooks.bats が捕まえる。ラッパーを噛ませずスクリプトを直接呼ぶ: `mkdir -p … && script 2>>log` の形はログディレクトリを作れないとリダイレクトの失敗でスクリプト自体が走らず、ログの問題が判定なし=フェイルオープンに化ける。ログ先の決定はスクリプト内に持たせてある。 */ -}}
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/git-push-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {{/* curl の宛先がループバックだけだと示せないときに `ask` を返すフック。`Bash(curl:*)` は permissions.ask に置かない: Claude Code 2.1.285 ではフックの `allow` が一致する ask ルールに負けるため、「ask を土台にループバック宛だけ緩める」向きが作れない(ADR 0009。測定は deprecated の 0008-command-guard-hooks-only-widen-an-approval-gate)。代わりにフック自身が `ask` を返す(フックの ask / deny は default でも auto mode でも効く)。ループバック宛だけの curl と curl を含まないコマンドは無出力で classifier に任せる。フックが未配置・クラッシュ・出力なしのときは curl は classifier の判定だけになる(Source 上の未配線は test/settings-hooks.bats が捕まえる) — git-push-guard と同じ向きで、`ask` を外した穴をフックで塞ぐ構成。permissions で書けない理由は git push と同じプレフィックス照合の限界で、URL はフラグの後ろ(`curl -sS -H … URL`)に来るため `Bash(curl http://localhost:*)` では届かない。判定は全階層がホワイトリスト(フラグ・パイプ先・URL スキーム・ホスト)で、読み切れない綴りは `ask`。宛先は localhost / 127.0.0.0/8 / [::1] のみで、0.0.0.0 と host.docker.internal は意図的に除外(前者は全インターフェイス表記、後者はホスト名解決依存)。残存: ループバックのリスナーは外部への中継になりうるので「宛先アドレスがループバック」は最終到達先の保証ではない — ただし `Bash(python3:*)` が既に allow にあり同じソケットを開けるため、これで新たな到達性が増えるわけではない(nono 側の同じ経路は dot_config/nono/CLAUDE.md の `open_port: [0]` に記載)。 */ -}}
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/curl-localhost-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {{/* 個人リポジトリ(lib/ticket-scope.bash の owner の許可リスト)での gh pr create を、ticket スキルの作成モードを経た本文(<!-- ticket-skill --> を含む)でなければ deny し、gh issue create は作成と relationship 設定を一度に行う create-issue.sh へ案内して deny するフック。課題は relationship・Closes・AC 対応表・関連 issue のメンションの「やり忘れ」で、スキルはモデルが使うと判断したときにしか起動しないため、作成の瞬間に決定的に止める。目的は起動忘れの防止で迂回の防止ではないので、読み切れない入力は通す(git-push-guard と逆の向き)。allow は返さない。設計は docs/superpowers/specs/2026-10-04-ticket-skill-design.md。 */ -}}
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/scripts/ticket-guard.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/notify.sh\" 2>>\"$HOME/.claude/logs/notify-errors.log\" || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {{ template "orca-agent-hook" . }}
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "type": "command",
    "command": "node --experimental-strip-types $HOME/.claude/statusline-command.ts"
  },
  "language": "japanese",
  {{/* outputStyle: Concise — 結果を先に述べ前置き・実況を省略し応答を短く保つ組み込みスタイル(Claude Code v2.1.237+)。明示的な説明依頼には通常通り詳しく答える。*/ -}}
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "network": {
      "allowedDomains": [
        "*.githubusercontent.com",
        "api.anthropic.com",
        "api.github.com",
        "codeload.github.com",
        "formulae.brew.sh",
        "github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "allowLocalBinding": true,
      {{/* 1Password SSH agent のソケット。Claude Code の git 署名は claude-code.inc(GIT_CONFIG_GLOBAL)でローカルの ai-agent 鍵 + ssh-keygen に上書きしているので、このソケットを使わない(鍵は ~/.ssh 外なので下の denyRead にも当たらない。サンドボックス内で署名付き commit を実測済み)。grant は Claude Code 内の他ツールが 1Password agent を使う可能性を残すために据え置いている。Seatbelt は deny-default で unix-socket への network-outbound を塞ぐので、外すとそうしたツールは `Could not connect to socket` で失敗する。macOS 限定キー(Linux の seccomp はパス単位でフィルタできず無視)。生成される SBPL と対照ペアによる検証は docs/solutions/integration-issues/native-sandbox-1password-socket-signing-2026-07-09.md。 */ -}}
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      {{/* Low-risk OS-managed temp/scratch dirs. The default write boundary grants only the working dir and the specific session $TMPDIR, not these roots, so writes to them are silently denied. Safe to grant because none hold $PATH executables, system config, or shell rc — the escalation surface the sandbox docs warn about. /tmp + /private/tmp are the macOS symlink pair; /var/folders is the Darwin per-user temp (_CS_DARWIN_USER_TEMP_DIR) that a bare `mktemp -d` and TMPDIR-ignoring libc calls resolve to. Removes silent write-denial friction for tools that hardcode /tmp or bypass $TMPDIR. */ -}}
      "allowWrite": [
        "/private/tmp",
        "/tmp",
        "/var/folders",
        "~/.cache",
        "~/.cargo",
        {{/* harness 自己改善ループの runtime state(queue.md / pending.jsonl / state.json / digests/)。/harness-reflect と /harness-review が Bash で書き戻すが、既定の write 境界の外なので EPERM になり、harness-doctor.sh の「harness dir writable」も偽 FAIL していた(2026-09-28 の harness-review で実測)。中身は非機密のメモだが、/harness-reflect と /harness-review のセッション(push や gh pr create ができる)が LLM 入力として読む。人間のゲートは PR のマージだけで、そのセッション中の副作用には掛からない。つまりこの許可で、どのプロジェクトのサンドボックス内プロセス(npm script、テスト)からでも、後の reflect/review セッションへ指示を注入する経路が増え、プロジェクトを跨いで持続する。「cwd には元から書ける」は比較にならない: cwd を読むのはそのプロジェクトのセッションだが、queue.md を読むのは dotfiles リポジトリで push できるセッションである。それでも受容する。多層防御は pending.jsonl 経由の任意ファイル読み取り(harness-reflect が transcript パスを ~/.claude/projects/ 配下に限って読む)だけを塞ぐ。queue.md や digests/ への直接の注入は PR レビューでしか止まらない。sandbox 設定はセッション開始時に読まれるので、効果は新しいセッションでしか確認できない。 */ -}}
        "~/.claude/harness",
        {{/* PR レビュー自動化ループの state ルート。ループは work/<repo> に作業コピーを作り、locks/ logs/ reviews/ failures/ へも書き込む。これらは cwd 外への書き込みになるため、既定の write 境界（cwd + セッション $TMPDIR）では silent deny になる。上の temp/scratch 群とは許可の根拠が別（OS 管理の一時領域ではなくツール固有の state ディレクトリ）で、$PATH 上の実行ファイル・システム設定・シェル rc は含まないため付与して安全。 */ -}}
        "~/.local/state/pr-review-automation-loop",
        "~/.npm",
        "~/.rustup",
        "~/Library/pnpm/store",
        "~/go"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc",
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/config",
        "~/.ssh/known_hosts",
        {{/* excludedCommands の `gh *` は文字列前方一致のため、直接 `gh ...` と打った場合のみサンドボックスを完全バイパスする。`sh -c "gh ..."` やラッパースクリプト経由の間接呼び出しは `gh *` にマッチせずサンドボックス内で実行され、denyRead の `~/.config/gh` により gh 自身の設定読み込みが `operation not permitted` で失敗する。hosts.yml/config.yml に平文トークンは含まれず（トークンは macOS Keychain 保管、`gh auth status` の `(keyring)` 表示で確認済み）、read 許可のみで機密性リスクはない。 */ -}}
        "~/.config/gh"
      ]
    },
    {{/* git push *: 当初は remote が git@github.com: 形式で github.com:22 への生 TCP が必要だったためサンドボックス外に出した。dot_gitconfig.tmpl の insteadOf を ssh→https に反転したので不要になっているはずだが、sandbox 設定はセッション開始時に読まれるため fresh session でしか検証できず、まだ外していない(未検証のフォローアップ。docs/solutions/workflow-issues/verification-through-the-wrong-resolution-path.md)。残存リスク(受容): git-push-guard フックが止めるのは破壊的な綴りだけなので、素の push は無確認で network.allowedDomains をバイパスする。塞ぐならここから git push * を外す。git commit はここに含めない: サンドボックス内で走るので、リポジトリ管理の pre-commit hook も Seatbelt の内側で実行される(worktree の共通 git dir への書き込みは Claude Code が自動許可。実測済み)。cwd 外へ書く・許可外ドメインへ通信する hook を足すときは allowWrite / allowedDomains の調整が要る。 */ -}}
    "excludedCommands": [
      "docker *",
      "gcloud *",
      "gh *",
      "git push *",
      "open *",
      "osascript *",
      "terraform *"
    ],
    {{/* gh/gcloud/terraform 等の Go 製 CLI をサンドボックス内（間接呼び出し経路）で実行すると、trustd 経由のTLS証明書検証ができず `x509: OSStatus -26276` で失敗する。直接 `gh ...` 等は excludedCommands でサンドボックス自体をバイパスするため影響なし。trustd への Mach lookup を許可する分セキュリティは低下するが（公式ドキュメントが明記）、間接呼び出しでの認証済みAPI呼び出しを成立させるため有効化する。 */ -}}
    "enableWeakerNetworkIsolation": true
  },
  {{/* autoUpdatesChannel: native install は既定で自動更新が有効で、このキーはチャネル選択のみ（"latest" は既定値なので挙動は変わらない）。「最新チャネルで自動更新する」意図を宣言として残すために明示する。~/.claude.json の autoUpdates: false は native では効いていない（versions/ に新版が溜まり symlink が切り替わるのを実測）。止めたいときは env の DISABLE_AUTOUPDATER=1。 */ -}}
  "autoUpdatesChannel": "latest",
  "effortLevel": "high",
  "theme": "dark",
  "tui": "fullscreen"
}
