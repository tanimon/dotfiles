  "model": "sonnet",
  {{/* advisorModel: サーバーサイド advisor tool の助言役モデル（指定可能なエイリアスは fable / opus / sonnet）。advisor は executor（メインモデル）以上のランクでないと attach されないため、上の "model": "sonnet" と対になって初めて機能する。/model で Opus に切り替えたセッションでは main では発動せず（サブエージェントでは発動しうる）、起動時通知でその旨が出る。トークン消費は増える。/advisor ダイアログが書き込む先は ~/.claude/settings.json だが、そのファイルはこの tmpl が全面所有しているため apply で消える。恒久設定はここに書くこと。 */ -}}
  "advisorModel": "opus",
  {{/* orca agent-hooks integration: orca injects a claude-hook.sh dispatcher into every hook event. The command runs ~/.orca/agent-hooks/claude-hook.sh only when it exists and is executable, else no-ops (cat >/dev/null) — safe to ship to machines without orca. Reflected here from the live ~/.claude/settings.json so chezmoi apply doesn't wipe it. */ -}}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/harness-briefing.sh\" 2>>\"$HOME/.claude/logs/harness-errors.log\" || true'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/notify.sh\" 2>>\"$HOME/.claude/logs/notify-errors.log\" || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=\"$CLAUDE_FILE\"; case \"$FILE\" in *.ts|*.tsx) pnpm lint:fix \"$FILE\" ;; *.go) gofmt -w \"$FILE\" ;; esac'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=\"$CLAUDE_FILE\"; case \"$FILE\" in *.env|*.env.*|*credentials*|*secret*) if command -v secretlint >/dev/null 2>&1; then OUTPUT=$(secretlint \"$FILE\" 2>&1) || { echo \"secretlint: potential secret detected in $FILE: $OUTPUT\" >&2; exit 1; }; fi ;; esac'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/harness-reflect-trigger.sh\" 2>>\"$HOME/.claude/logs/harness-errors.log\" || true'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p \"$HOME/.claude/logs\" && \"$HOME/.claude/scripts/notify.sh\" 2>>\"$HOME/.claude/logs/notify-errors.log\" || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -r '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ] && [ -x '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '{{ .chezmoi.homeDir }}/.orca/agent-hooks/claude-hook.sh'; else { command -p cat 2>/dev/null || cat; } >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node --experimental-strip-types $HOME/.claude/statusline-command.ts"
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "network": {
      "allowedDomains": [
        "*.githubusercontent.com",
        "api.anthropic.com",
        "api.github.com",
        "codeload.github.com",
        "formulae.brew.sh",
        "github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "allowLocalBinding": true,
      {{/* 1Password SSH agent のソケット。commit 署名時に op-ssh-sign がここへ接続する（`gpg.format=ssh` / `gpg.ssh.program`、dot_gitconfig.tmpl 参照）。Seatbelt は deny-default で unix-socket への network-outbound を塞ぐため、許可しないと署名が `1Password: Could not connect to socket` → `fatal: failed to write commit object` で失敗する（サンドボックス内で実測）。v2.1.205 には本キーが存在せず `excludedCommands` で git commit をサンドボックス外に出す回避策を取っていたが、v2.1.220 で `network.allowUnixSockets` が追加されたため回避策を撤去した。macOS 限定キー（Linux の seccomp はパス単位でフィルタできないため無視される）。生成されるルールは `(allow system-socket (socket-domain AF_UNIX))` + `(allow network-outbound (remote unix-socket (subpath <path>)))` で、同等の SBPL を sandbox-exec に直接与えて ssh-add -l の成否が反転することを確認済み。パスに空白を含むが Seatbelt 側でクォートされる。 */ -}}
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      {{/* Low-risk OS-managed temp/scratch dirs. The default write boundary grants only the working dir and the specific session $TMPDIR, not these roots, so writes to them are silently denied. Safe to grant because none hold $PATH executables, system config, or shell rc — the escalation surface the sandbox docs warn about. /tmp + /private/tmp are the macOS symlink pair; /var/folders is the Darwin per-user temp (_CS_DARWIN_USER_TEMP_DIR) that a bare `mktemp -d` and TMPDIR-ignoring libc calls resolve to. Removes silent write-denial friction for tools that hardcode /tmp or bypass $TMPDIR. */ -}}
      "allowWrite": [
        "/private/tmp",
        "/tmp",
        "/var/folders",
        "~/.cache",
        "~/.cargo",
        "~/.npm",
        "~/.rustup",
        "~/Library/pnpm/store",
        "~/go"
      ],
      "denyRead": [
        "~/.aws/credentials",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.netrc",
        "~/.ssh"
      ],
      "allowRead": [
        "~/.ssh/config",
        "~/.ssh/known_hosts"
      ]
    },
    {{/* `git push` はサンドボックス外で実行する。**2026-07-31 更新:** ここに書かれていた「remote が git@github.com: 形式のため github.com:22 への生TCPが必要」という前提は、dot_gitconfig.tmpl の insteadOf を https→ssh から ssh→https に反転したことで崩れた（詳細は dot_gitconfig.tmpl 側のコメント参照）。fetch/pull はこれで HTTPS 経由になり動作を実測済みだが、push については新しい gitconfig を読み込んだ fresh session でしか検証できない（sandbox設定はセッション開始時に読み込まれるため、このセッション内での確認は無意味 — CLAUDE.md の "verification through the wrong resolution path" を参照）。したがって `excludedCommands` からの `git push *` 除去は本コメント更新時点では未実施・未検証のフォローアップとする。push は permissions.ask でゲートしてあるので、サンドボックス外実行と network.allowedDomains のバイパスはプロンプトで抑止される。`git commit` は上の network.allowUnixSockets で署名が通るようになったため、この一覧から外してサンドボックス内で実行する（worktree の共通 git dir への書き込みは Claude Code が自動許可するため commit 自体は成立する — 実測済み）。これにより「allow に入った git commit を経由してリポジトリ管理の pre-commit hook がサンドボックス外・無プロンプトで実行される」という残存リスクは解消した。prek/secretlint はサンドボックス内で動くため、cwd 外への書き込みや許可外ドメインへの通信を行う hook を追加する場合は allowWrite / allowedDomains 側の調整が必要になる。 */ -}}
    "excludedCommands": [
      "docker *",
      "gcloud *",
      "gh *",
      "git push *",
      "open *",
      "osascript *",
      "terraform *"
    ]
  },
  "effortLevel": "high",
  "theme": "dark",
  "tui": "fullscreen"
}
