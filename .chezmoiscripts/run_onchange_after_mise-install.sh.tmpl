#!/usr/bin/env bash
set -euo pipefail

# mise global config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

# lint ツールは Brewfile に無く、グローバルの mise 設定から入る(ADR 0023)。mise が一度も入れていない
# ツールは shim も無く、PATH 上の別の導入元(既存のマシンに残った Homebrew 版など)が黙って使われるので、
# 入れられなければ失敗させる。exit 0 で skip すると run_onchange_ は実行済みと記録され、設定が変わるまで
# 次の apply でも走らない
if ! command -v mise &>/dev/null; then
  echo "mise not found; re-run 'chezmoi apply' once mise (darwin/Brewfile) is on PATH" >&2
  exit 1
fi

# chezmoi の作業ディレクトリに依存しない。リポジトリの中で実行すると、リポジトリの mise.toml の版も入れて
# そのディレクトリを信頼済みにする
cd "$HOME"
echo "Installing tools from the global mise config..."
mise install
