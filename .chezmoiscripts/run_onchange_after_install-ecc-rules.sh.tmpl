{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# ecc-rules-languages hash: {{ include "dot_claude/ecc-rules-languages.txt" | sha256sum }}

# ecc の rules はネイティブ plugin cache（`enabledPlugins` の `ecc@ecc`）から取り込む。
# バージョンディレクトリ名を決め打ちせず、installed_plugins.json の installPath を正典とする。
# 注意: このスクリプトのハッシュゲートは ecc-rules-languages.txt にしか掛かっていないので、
# `claude plugin update ecc` 後に rules を再コピーするには languages.txt を触るか手動実行が要る。
INSTALLED_PLUGINS="{{ .chezmoi.homeDir }}/.claude/plugins/installed_plugins.json"
command -v jq >/dev/null 2>&1 || { echo "WARNING: jq not found, skipping ECC rules installation"; exit 0; }
ECC_MARKETPLACE_DIR="$(jq -r '.plugins["ecc@ecc"][0].installPath // empty' "$INSTALLED_PLUGINS" 2>/dev/null || true)"

if [ -z "$ECC_MARKETPLACE_DIR" ] || [ ! -d "$ECC_MARKETPLACE_DIR/rules" ]; then
  echo "WARNING: ecc plugin not installed (run: claude plugin install ecc@ecc), skipping rules installation"
  exit 0
fi

RULES_SRC="$ECC_MARKETPLACE_DIR/rules"
RULES_DST="{{ .chezmoi.homeDir }}/.claude/rules"

while IFS= read -r lang || [ -n "$lang" ]; do
  [[ -z "$lang" || "$lang" == \#* ]] && continue
  if [ ! -d "$RULES_SRC/$lang" ]; then
    echo "WARNING: ECC rules directory not found: $RULES_SRC/$lang"
    continue
  fi
  mkdir -p "$RULES_DST/$lang"
  cp -r "$RULES_SRC/$lang/"* "$RULES_DST/$lang/"
  echo "Installed ECC rules: $lang ($(ls "$RULES_SRC/$lang/" | wc -l | tr -d ' ') files)"
done < "{{ .chezmoi.sourceDir }}/dot_claude/ecc-rules-languages.txt"
{{ end -}}
