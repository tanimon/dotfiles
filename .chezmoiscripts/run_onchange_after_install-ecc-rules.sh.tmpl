{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# ecc-rules-languages hash: {{ include "dot_claude/ecc-rules-languages.txt" | sha256sum }}

# ECC_ prefix is historical (from when the plugin was named "ecc"). This used to
# read from the Claude Code native marketplace clone at
# ~/.claude/plugins/marketplaces/everything-claude-code, generated by the
# `claude plugin marketplace add` mechanism (see
# docs/plans/2026-04-19-001-fix-ecc-plugin-rename-plan.md for that path's rename
# history). That mechanism was removed by the APM Skill/MCP management migration
# (docs/superpowers/specs/2026-08-02-apm-skill-mcp-management-design.md), so on a
# fresh machine the marketplace directory is never created and this script would
# permanently no-op. It now reads from APM's dependency expansion instead, which
# `dot_apm/apm.yml`'s `dependencies.apm` entry (affaan-m/everything-claude-code#v2.1.0)
# guarantees is present after `apm install --global --target claude` runs.
ECC_MARKETPLACE_DIR="{{ .chezmoi.homeDir }}/.apm/apm_modules/affaan-m/everything-claude-code"

if [ ! -d "$ECC_MARKETPLACE_DIR/rules" ]; then
  echo "WARNING: ECC marketplace not found at $ECC_MARKETPLACE_DIR, skipping rules installation"
  exit 0
fi

RULES_SRC="$ECC_MARKETPLACE_DIR/rules"
RULES_DST="{{ .chezmoi.homeDir }}/.claude/rules"

while IFS= read -r lang || [ -n "$lang" ]; do
  [[ -z "$lang" || "$lang" == \#* ]] && continue
  if [ ! -d "$RULES_SRC/$lang" ]; then
    echo "WARNING: ECC rules directory not found: $RULES_SRC/$lang"
    continue
  fi
  mkdir -p "$RULES_DST/$lang"
  cp -r "$RULES_SRC/$lang/"* "$RULES_DST/$lang/"
  echo "Installed ECC rules: $lang ($(ls "$RULES_SRC/$lang/" | wc -l | tr -d ' ') files)"
done < "{{ .chezmoi.sourceDir }}/dot_claude/ecc-rules-languages.txt"
{{ end -}}
