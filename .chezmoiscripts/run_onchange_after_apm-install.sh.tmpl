{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# apm.yml hash: {{ include "dot_apm/apm.yml" | sha256sum }}
#
# dependencies.apm (Skill/plugin管理)はネイティブmarketplace方式
# (settings.json.tmplのenabledPlugins/extraKnownMarketplaces)に移行済みのため、
# apm.ymlにはdependencies.mcpのみが残る。MCPサーバーの展開先は~/.claude.jsonの
# mcpServersキーと~/.codex/config.tomlの[mcp_servers.*]テーブルで、chezmoiは
# どちらも.tmplとして所有していない(競合する完全所有テンプレートが存在しない)ため、
# apm.ymlのハッシュ変化時のみ実行すれば十分(run_after_ではなくrun_onchange_で問題ない)。
#
# --target は apm.yml の targets: と意図的に二重宣言している。--target を省略すると
# APM は auto-detect にフォールバックし、検出した「global-capable」な全ランタイム
# (Gemini CLI・Kiro 等)へ fan out する。宣言が apm.yml 側だけだと、キー名の変更や
# 書式ミスでその fan out に黙って落ちる(フェイルオープン)ので冗長さを買う。
# 配布先の選定根拠と APM の所有範囲:
# docs/adr/0006-apm-owns-only-the-mcp-servers-table-of-codex-config.md

if ! command -v apm &>/dev/null; then
  echo "apm CLI not found, skipping apm install --global"
  exit 0
fi

# 配布先は 1 箇所だけに書き、コマンドと失敗メッセージの両方がそれを参照する。
# メッセージに配布先を書き写すとコマンド側だけを直したときに古い配布先を案内し
# 続けるが、メッセージから配布先を伏せると「手で再実行しろ」と言われた側に何を
# 打てばよいのかが残らない(chezmoi apply の出力にスクリプト本文は出ない)。
apm_targets='claude,codex'

# APM が実際に書き込むと ~/.claude.json の symlink が通常ファイルへ置き換わり、
# 旧 ~/.claude/claude.json が変更前の mcpServers を抱えたまま取り残される
# (split-brain)。検出して知らせるだけにとどめ、復旧は手で行う — トポロジは
# Claude Code 側の都合で変わるので、スクリプトが勝手に張り直すと逆に壊す。
claude_json_was_symlink=false
if [ -L '{{ .chezmoi.homeDir }}/.claude.json' ]; then
  claude_json_was_symlink=true
fi

apm install --global --target "${apm_targets}" || echo "WARNING: apm install --global --target ${apm_targets} failed; re-run it manually to sync MCP servers" >&2

if [ "${claude_json_was_symlink}" = true ] && [ ! -L '{{ .chezmoi.homeDir }}/.claude.json' ]; then
  echo "WARNING: apm replaced the ~/.claude.json symlink with a regular file; ~/.claude/claude.json now holds stale mcpServers. Restore: cp ~/.claude.json ~/.claude/claude.json && rm ~/.claude.json && ln -s .claude/claude.json ~/.claude.json" >&2
fi
{{ end -}}
