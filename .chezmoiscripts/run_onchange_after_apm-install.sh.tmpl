{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail

# apm.yml hash: {{ include "dot_apm/apm.yml" | sha256sum }}
# installer hash: {{ include "scripts/apm-install-global.sh" | sha256sum }}
#
# dependencies.apm (Skill/plugin管理)はネイティブmarketplace方式
# (settings.json.tmplのenabledPlugins/extraKnownMarketplaces)に移行済みのため、
# apm.ymlにはdependencies.mcpのみが残る。MCPサーバーの展開先は~/.claude.jsonの
# mcpServersキーと~/.codex/config.tomlの[mcp_servers.*]テーブルで、chezmoiは
# どちらも.tmplとして所有していない(競合する完全所有テンプレートが存在しない)ため、
# apm.ymlのハッシュ変化時のみ実行すれば十分(run_after_ではなくrun_onchange_で問題ない)。
#
# 実体は scripts/apm-install-global.sh にある。--target の二重宣言の根拠、
# ~/.claude.json の symlink を一時的に外す理由(APM 0.30.0 の prune ガード)、
# symlink を廃止できない理由(張っているのは nono)は、すべてそのスクリプトの
# 冒頭コメントに書いてある。ここに写すと二重管理になるので繰り返さない。
# 配布先の選定根拠と APM の所有範囲:
# docs/adr/0006-apm-owns-only-the-mcp-servers-table-of-codex-config.md
#
# .tmpl は shellcheck / shfmt / bats のいずれからも見えない(Go テンプレート構文が
# 通らない)ので、判断を含むロジックは素の .sh 側に置いて test/apm-install-global.bats で
# 覆う。ここはディスパッチだけに保つこと。

# apm 自身の失敗では apply を止めない(従来どおり。MCP が古いだけで、次の apply か
# 手動再実行で追いつく)。唯一 70 — de-link 中に ~/.claude/claude.json が再出現して
# 復旧を中断した場合 — だけは伝播させる。放置すると「両方が通常ファイル」のまま
# 次の nono 起動が片方を上書きするので、警告 1 行では埋もれてしまう。
status=0
bash '{{ .chezmoi.sourceDir }}/scripts/apm-install-global.sh' || status=$?
if [ "${status}" -eq 70 ]; then
    exit 70
elif [ "${status}" -ne 0 ]; then
    echo "WARNING: see the message above; MCP servers may be out of sync until it is resolved" >&2
fi
{{ end -}}
